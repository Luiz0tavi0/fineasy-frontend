{
  "name": "fineasy-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:report": "playwright show-report",
    "e2e:db:up": "docker compose -f e2e/docker-compose.yml up -d --wait",
    "e2e:db:down": "docker compose -f e2e/docker-compose.yml down --remove-orphans",
    "e2e": "pnpm e2e:db:up && playwright test",
    "e2e:headed": "pnpm e2e:db:up && playwright test --headed",
    "e2e:ui": "pnpm e2e:db:up && playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}